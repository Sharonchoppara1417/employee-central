{
  "_version": "1.90.0",
  "sap.app": {
    "id": "com.ec.hrportal.employeecentral",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.34.0",
      "toolsId": "f5a4f884-7706-4be9-bdab-fd517127a530"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },



  "sap.ui5": {
  "flexEnabled": false,
  "dependencies": {
    "minUI5Version": "1.153.0",
    "libs": {
      "sap.m": {},
      "sap.ui.core": {}
    }
  },
  "contentDensities": {
    "compact": true,
    "cozy": true
  },
  "models": {
    "i18n": {
      "type": "sap.ui.model.resource.ResourceModel",
      "settings": {
        "bundleName": "com.ec.hrportal.employeecentral.i18n.i18n"
      }
    }
  },
  "resources": {
    "css": [
      { "uri": "css/style.css" }
    ]
  },
  "rootView": {
    "viewName": "com.ec.hrportal.employeecentral.view.App",
    "type": "XML",
    "id": "App",
    "async": true
  },
  "routing": {
    "config": {
      "routerClass": "sap.m.routing.Router",
      "viewType": "XML",
      "path": "com.ec.hrportal.employeecentral.view",
      "controlId": "app",
      "controlAggregation": "pages",
      "transition": "slide",
      "async": true
    },
    "routes": [
      {
        "name": "main",
        "pattern": ":section:",
        "target": "main"
      }
    ],
    "targets": {
      "main": {
        "viewName": "View1",
        "viewId": "View1"
      }
    }
  },
    "rootView": {
      "viewName": "com.ec.hrportal.employeecentral.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }

}